# ─── Subdomain isolation ───────────────────────────────────────
# Prevent inheritance of parent .htaccess rewrite rules.
# This is critical on GoDaddy shared hosting where the main
# domain's .htaccess otherwise hijacks subdomain requests.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteOptions IgnoreInherit
</IfModule>

# ─── Standard Laravel handling ────────────────────────────────
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Block sensitive files ────────────────────────────────────
<FilesMatch "^(\.env|\.git|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# ─── Blocked sources ──────────────────────────────────────────
# 2026-09-21. A coordinated probe on 20 Sep, 07:56–08:31, from two addresses:
#   202.61.157.28  109 failed logins in 18 minutes, SQL-injection payloads
#                  (a' OR '1'='1--), enumeration of guessed addresses, 42
#                  unauthenticated POSTs to /admin/branding/logo, and 14 password
#                  guesses against info@ilearnhcc.com (a live agency-admin account).
#   23.154.84.231  266 hits probing for login endpoints that do not exist
#                  (/api/v1/login, /parent/login, /auth/signin) and 3 password-reset
#                  attempts for addresses we do not hold.
# Nothing succeeded — every attempt came back 401/403/422 — and neither address had
# ever been seen before that morning. Confirmed with Anthony as NOT an authorised test.
# Denied here rather than in PHP so the request costs nothing and never reaches Laravel.
<RequireAll>
    Require all granted
    Require not ip 202.61.157.28
    Require not ip 23.154.84.231
</RequireAll>
