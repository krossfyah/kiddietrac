# ═══════════════════════════════════════════════════════════════════
#  KIDDIETRAC BACKEND — Environment Configuration
#  Copy this to .env and fill in real values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════

# ──────────────── APP ────────────────
APP_NAME=Kiddietrac
APP_ENV=production
APP_KEY=                              # run: php artisan key:generate
APP_DEBUG=false                       # FALSE in production!
APP_URL=https://api.kiddietrac.ca
APP_TIMEZONE=America/Toronto
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ──────────────── DATABASE (GoDaddy MySQL) ────────────────
DB_CONNECTION=mysql
DB_HOST=localhost                     # On GoDaddy shared = localhost; VPS = 127.0.0.1
DB_PORT=3306
DB_DATABASE=kiddietrac
DB_USERNAME=                          # from cPanel MySQL Databases
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ──────────────── SESSIONS / CACHE ────────────────
# 'file' works on GoDaddy shared hosting. 'redis' if VPS with Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database             # database queue works on GoDaddy

# ──────────────── BROADCAST (real-time) ────────────────
# GoDaddy doesn't support WebSockets natively. Use Pusher or Ably.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# ──────────────── FILE STORAGE ────────────────
# Start with GoDaddy local storage; migrate to S3/B2 when you scale.
FILESYSTEM_DISK=local                 # later: s3 or backblaze
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_BUCKET=kiddietrac-media
AWS_USE_PATH_STYLE_ENDPOINT=false

# ──────────────── AI (Anthropic Claude for digests) ────────────────
ANTHROPIC_API_KEY=                    # from console.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # cheaper for digests
ANTHROPIC_DIGEST_HOUR=18              # 6pm — when daily digests generate

# ──────────────── PAYMENTS (Stripe) ────────────────
STRIPE_KEY=pk_live_                   # publishable
STRIPE_SECRET=sk_live_                # secret — server only
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CURRENCY=cad

# ──────────────── EMAIL ────────────────
# GoDaddy email or use a transactional provider (recommended).
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com        # or GoDaddy: smtpout.secureserver.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@kiddietrac.ca
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────── SMS (Twilio for Canada) ────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1xxxxxxxxxx

# ──────────────── PUSH NOTIFICATIONS (Firebase) ────────────────
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=kiddietrac-prod

# ──────────────── SECURITY ────────────────
SANCTUM_STATEFUL_DOMAINS=app.kiddietrac.ca,localhost
SESSION_DOMAIN=.kiddietrac.ca
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ──────────────── LOGS ────────────────
LOG_CHANNEL=daily                     # rotates logs daily — important on shared hosting!
LOG_LEVEL=warning                     # 'debug' only in staging
LOG_DAYS=14
