# KT-NOEXPOSE (2026-10-14): backup copies, logs and dumps are never served
# (app.js.bak-*, .htaccess.bak-*, error_log were all downloadable).
<FilesMatch "\.(bak|orig|old)([-._].*)?$|\.(sql|log)$|^_htaccess$|^error_log$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# KT-HTTPS (2026-10-21): every plain-HTTP request goes to HTTPS. Without this the portal
# and the API answered on http:// too, so a first visit, an old bookmark or a captive Wi-Fi
# could carry a sign-in unencrypted (HSTS only protects browsers that have already been here).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# KiddieTrac parent-portal (app.kiddietrac.com) — v22p84
# Performance (compression + caching) and security headers.
# Every block is guarded by <IfModule> so a missing module is a no-op, never a 500.

# ─── Compression ────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# ─── Caching ────────────────────────────────────────────────────────
# HTML is the app shell — keep it fresh so deploys show up (the service worker
# is already network-first for HTML). Versioned JS/CSS (?v=) cache for a day;
# images/fonts longer. A day is short enough that an un-stamped change is picked
# up quickly, long enough to avoid re-requesting on every navigation.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  # Shared photos and video carry a unique filename per upload, so they are safe
  # to cache. Video had NO cache header at all, which meant a 12MB clip was
  # re-downloaded in full every time a parent opened the gallery.
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/quicktime "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType video/3gpp "access plus 30 days"
  ExpiresByType image/heic "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# Flag fingerprinted (?v=) JS/CSS requests so the header block below can cache them
# forever. mod_rewrite is the reliable way to inspect the query string in .htaccess.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # KT-SLASH (2026-10-21, Cloudways): add a folder's trailing slash ourselves. Apache's own
  # DirectorySlash redirect is built from the INTERNAL path on this host, so /blog went to
  # http://www.kiddietrac.com/public_html/blog/ (a 404). THE_REQUEST holds the path the
  # visitor asked for, before any host routing.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{THE_REQUEST} ^\S+\s([^?\s]*[^/?\s])(\?\S*)?\s
  RewriteRule ^ https://%{HTTP_HOST}%1/ [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)v=
  RewriteRule \.(js|css)$ - [E=KT_VERSIONED:1]
</IfModule>

<IfModule mod_headers.c>
  # Don't let the HTML shell get cached anywhere.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ─── Fingerprinted assets cache for a year, immutable ─────────────
  # Any request carrying a ?v= cache-buster (every JS/CSS <script>/<link> in
  # dashboard.html is stamped) is safe to cache forever: a deploy bumps the ?v=,
  # which is a NEW url the browser must fetch. This turns repeat/return loads of
  # the ~180 assets into instant memory-cache hits instead of a day-long
  # revalidation. Scoped to the query string so UN-stamped files (service-worker.js,
  # the HTML shell) are untouched and keep their short/no-cache rules below.
  # NOTE: SetEnvIf cannot read the query string, so the env is set via mod_rewrite.
  Header set Cache-Control "public, max-age=31536000, immutable" env=KT_VERSIONED

  # ─── Security headers ─────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  # X-Frame-Options removed (2026-10-31): it cannot name an allowed origin, and the website's live phone demo frames
  # this app. frame-ancestors below is the control: only this app itself and kiddietrac.com may frame it.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), payment=(self)"
  # Clickjacking defence-in-depth (complements X-Frame-Options). No script/style
  # rules here — the SPA relies on inline scripts, so a full CSP needs a separate
  # nonce refactor (tracked as a SOC 2 gap).
  Header always set Content-Security-Policy "frame-ancestors 'self' https://www.kiddietrac.com https://kiddietrac.com"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # HSTS — the portal is HTTPS-only. Scoped to this host (no includeSubDomains)
  # so it can't affect other subdomains that may not be HTTPS. 1 year.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ─── Service worker: NEVER HTTP-cache it ─────────────────────────────
# service-worker.js is requested un-versioned (/service-worker.js). The blanket
# .js rule above gave it max-age=1day, so a browser/WebView treated the OLD worker
# as "fresh" and didn't re-fetch it for up to a day — meaning deploys (and their
# SW cache-version bump) never activated on the device. Force a fresh fetch every
# load so a new worker installs immediately.
<FilesMatch "service-worker\.js$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header unset Expires
  </IfModule>
</FilesMatch>

# Training captions (2026-10-01): Chrome ignores a <track> whose file has no text/vtt type.
<IfModule mod_mime.c>
  AddType text/vtt .vtt
</IfModule>
