# KiddieTrac parent-portal (app.kiddietrac.com) — v22p84
# Performance (compression + caching) and security headers.
# Every block is guarded by <IfModule> so a missing module is a no-op, never a 500.

# ─── Compression ────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# ─── Caching ────────────────────────────────────────────────────────
# HTML is the app shell — keep it fresh so deploys show up (the service worker
# is already network-first for HTML). Versioned JS/CSS (?v=) cache for a day;
# images/fonts longer. A day is short enough that an un-stamped change is picked
# up quickly, long enough to avoid re-requesting on every navigation.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  # Shared photos and video carry a unique filename per upload, so they are safe
  # to cache. Video had NO cache header at all, which meant a 12MB clip was
  # re-downloaded in full every time a parent opened the gallery.
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/quicktime "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType video/3gpp "access plus 30 days"
  ExpiresByType image/heic "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# Flag fingerprinted (?v=) JS/CSS requests so the header block below can cache them
# forever. mod_rewrite is the reliable way to inspect the query string in .htaccess.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)v=
  RewriteRule \.(js|css)$ - [E=KT_VERSIONED:1]
</IfModule>

<IfModule mod_headers.c>
  # Don't let the HTML shell get cached anywhere.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ─── Fingerprinted assets cache for a year, immutable ─────────────
  # Any request carrying a ?v= cache-buster (every JS/CSS <script>/<link> in
  # dashboard.html is stamped) is safe to cache forever: a deploy bumps the ?v=,
  # which is a NEW url the browser must fetch. This turns repeat/return loads of
  # the ~180 assets into instant memory-cache hits instead of a day-long
  # revalidation. Scoped to the query string so UN-stamped files (service-worker.js,
  # the HTML shell) are untouched and keep their short/no-cache rules below.
  # NOTE: SetEnvIf cannot read the query string, so the env is set via mod_rewrite.
  Header set Cache-Control "public, max-age=31536000, immutable" env=KT_VERSIONED

  # ─── Security headers ─────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), payment=(self)"
  # Clickjacking defence-in-depth (complements X-Frame-Options). No script/style
  # rules here — the SPA relies on inline scripts, so a full CSP needs a separate
  # nonce refactor (tracked as a SOC 2 gap).
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # HSTS — the portal is HTTPS-only. Scoped to this host (no includeSubDomains)
  # so it can't affect other subdomains that may not be HTTPS. 1 year.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ─── Service worker: NEVER HTTP-cache it ─────────────────────────────
# service-worker.js is requested un-versioned (/service-worker.js). The blanket
# .js rule above gave it max-age=1day, so a browser/WebView treated the OLD worker
# as "fresh" and didn't re-fetch it for up to a day — meaning deploys (and their
# SW cache-version bump) never activated on the device. Force a fresh fetch every
# load so a new worker installs immediately.
<FilesMatch "service-worker\.js$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header unset Expires
  </IfModule>
</FilesMatch>
